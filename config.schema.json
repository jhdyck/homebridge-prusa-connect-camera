k{
  "pluginAlias": "PrusaConnectCamera",
  "pluginType": "platform",
  "schema": {
    "type": "object",
    "title": "",
    "properties": {
      "name": {
        "title": "Camera Name",
        "type": "string",
        "default": "Camera"
      },
      "videoSource": {
        "title": "Video Source (e.g. /dev/video0)",
        "type": "string",
        "default": "-f v4l2 -video_size 960x720 -i /dev/video0",
        "description": "Full ffmpeg input arguments for your camera. Example for a USB webcam: -f v4l2 -video_size 960x720 -i /dev/video0"
      },
      "token": {
        "title": "Prusa Connect Token",
        "type": "string"
      },
      "fingerprint": {
        "title": "Camera Fingerprint (leave blank to generate automatically)",
        "type": "string",
        "description": "If left blank, a fingerprint will be generated and saved on first run."
      },
      "snapshotInterval": {
        "title": "Snapshot Interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 10,
        "maximum": 60
      },
      "debugLogging": {
        "title": "Enable Debug Logging",
        "type": "boolean",
        "default": false,
        "description": "Print detailed logs for troubleshooting. Leave off under normal operation."
      },
      "rebroadcastEnabled": {
        "title": "[EXPERIMENTAL] Enable Video Rebroadcasting",
        "type": "boolean",
        "default": false,
        "description": "When enabled, the plugin exclusively owns the camera and exposes an MJPEG stream and a snapshot URL for other plugins (e.g., Camera FFmpeg)."
      },
      "rebroadcastPort": {
        "title": "Rebroadcast Port",
        "type": "integer",
        "default": 8088,
        "minimum": 1,
        "maximum": 65535,
        "condition": { "functionBody": "return model.rebroadcastEnabled === true;" }
      },
      "streamFps": {
        "title": "Stream FPS",
        "type": "integer",
        "default": 15,
        "minimum": 1,
        "maximum": 60,
        "condition": { "functionBody": "return model.rebroadcastEnabled === true;" }
      },
      "mjpegQuality": {
        "title": "MJPEG Quality (2..31, lower = better)",
        "type": "integer",
        "default": 7,
        "minimum": 2,
        "maximum": 31,
        "condition": { "functionBody": "return model.rebroadcastEnabled === true;" }
      },
      "maxFrameAgeMs": {
        "title": "Max Frame Age for Upload (ms)",
        "type": "integer",
        "default": 5000,
        "minimum": 500,
        "maximum": 60000,
        "condition": { "functionBody": "return model.rebroadcastEnabled === true;" },
        "description": "If the latest frame is older than this, the plugin skips uploading that cycle."
      },
      "rebroadcastStreamUrl": {
        "title": "Stream URL (copy to Camera FFmpeg → source)",
        "type": "string",
        "readOnly": true,
        "default": "http://127.0.0.1:8088/stream.mjpg",
        "condition": { "functionBody": "return model.rebroadcastEnabled === true;" },
        "description": "If you change the port, update the URL accordingly."
      },
      "rebroadcastSnapshotUrl": {
        "title": "Snapshot URL (copy to Camera FFmpeg → stillImageSource)",
        "type": "string",
        "readOnly": true,
        "default": "http://127.0.0.1:8088/snapshot.jpg",
        "condition": { "functionBody": "return model.rebroadcastEnabled === true;" },
        "description": "If you change the port, update the URL accordingly."
      }
    },
    "required": ["name", "videoSource", "token"],
    "layout": [
      {
        "type": "fieldset",
        "title": "Prusa Connect Settings",
        "items": [
          "name",
          "videoSource",
          "token",
          "fingerprint",
          "snapshotInterval",
          "debugLogging"
        ]
      },
      {
        "type": "fieldset",
        "title": "Video Rebroadcasting (Experimental)",
        "expandable": true,
        "expanded": false,
        "items": [
          "rebroadcastEnabled",
          { "key": "rebroadcastPort", "condition": { "functionBody": "return model.rebroadcastEnabled === true;" } },
          { "key": "streamFps", "condition": { "functionBody": "return model.rebroadcastEnabled === true;" } },
          { "key": "mjpegQuality", "condition": { "functionBody": "return model.rebroadcastEnabled === true;" } },
          { "key": "maxFrameAgeMs", "condition": { "functionBody": "return model.rebroadcastEnabled === true;" } },
          { "key": "rebroadcastStreamUrl", "condition": { "functionBody": "return model.rebroadcastEnabled === true;" } },
          { "key": "rebroadcastSnapshotUrl", "condition": { "functionBody": "return model.rebroadcastEnabled === true;" } }
        ]
      }
    ]
  }
}
